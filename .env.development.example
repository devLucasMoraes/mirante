# Development environment
# Copy to .env.development and change the passwords before `docker compose up -d`.
#   cp .env.development.example .env.development

# MongoDB container + connection string (app)
MONGODB_PORT=27017
MONGO_CONTAINER_NAME=mongodb
MONGO_INITDB_DATABASE=my_monorepo

# Root user of the MongoDB instance (used only to initialize; never use in the app)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=dev_root_password_change_me

# Application user (readWrite on MONGO_INITDB_DATABASE) — use this in the app connection string
MONGO_INITDB_USERNAME=app
MONGO_INITDB_PASSWORD=dev_app_password_change_me

# MongoDB Express (dev/UI inspection only, requires basic auth)
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_CONTAINER_NAME=mongo-express
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=dev_express_password_change_me
# Session/cookie secrets (required by mongo-express) — generate with: openssl rand -hex 32
ME_CONFIG_SITE_COOKIESECRET=dev_cookie_secret_change_me
ME_CONFIG_SITE_SESSIONSECRET=dev_session_secret_change_me