# Production environment
# Copy to .env.production and change the passwords before starting the prod stack.
#   cp .env.production.example .env.production

MONGODB_PORT=27017
MONGO_CONTAINER_NAME=mirante-mongodb-prod
MONGO_INITDB_DATABASE=mirante

# Root user of the MongoDB instance (used only to initialize; never use in the app)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=prod_root_password_change_me

# Application user (readWrite on MONGO_INITDB_DATABASE) — use this in the app connection string
MONGO_INITDB_USERNAME=app
MONGO_INITDB_PASSWORD=prod_app_password_change_me

# Authentication (generate secrets with: openssl rand -hex 32)
JWT_ACCESS_SECRET=prod_access_secret_change_me_0000000000
JWT_REFRESH_SECRET=prod_refresh_secret_change_me_000000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECRET=prod_cookie_secret_change_me_00000000000000
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12

# Initial admin created by `pnpm --filter api seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_PASSWORD=admin123

# Wingraphex ERP (leitura) — em prod a API usa o banco real da rede da empresa (192.168.1.16:3307).
# Senha = WINGRAPHEX_READ_PASSWORD do docker/wingraphex/.env. Banco é somente leitura (SELECT/SHOW).
WINGRAPHEX_DB_HOST=192.168.1.16
WINGRAPHEX_DB_PORT=3307
WINGRAPHEX_DB_USER=_consulta
WINGRAPHEX_DB_PASSWORD=change_me
WINGRAPHEX_DB_NAME=wingraphex