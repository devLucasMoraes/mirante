# Production environment
# Copy to .env.production and change the passwords before starting the prod stack.
#   cp .env.production.example .env.production

MONGODB_PORT=27017
MONGO_CONTAINER_NAME=mongodb-prod
MONGO_INITDB_DATABASE=my_monorepo

# Root user of the MongoDB instance (used only to initialize; never use in the app)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=prod_root_password_change_me

# Application user (readWrite on MONGO_INITDB_DATABASE) — use this in the app connection string
MONGO_INITDB_USERNAME=app
MONGO_INITDB_PASSWORD=prod_app_password_change_me