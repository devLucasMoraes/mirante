# Test environment
# Copy to .env.test and change the passwords before starting the test stack.
#   cp .env.test.example .env.test

# MongoDB container — uses a different port and data volume to not clash with dev
MONGODB_PORT_TEST=27018
MONGO_CONTAINER_NAME=mirante-mongodb-test
MONGO_INITDB_DATABASE=mirante_test

# Root user of the MongoDB instance (used only to initialize; never use in the app)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=test_root_password_change_me

# Application user (readWrite on MONGO_INITDB_DATABASE) — use this in the app connection string
MONGO_INITDB_USERNAME=app
MONGO_INITDB_PASSWORD=test_app_password_change_me

# Authentication (generate secrets with: openssl rand -hex 32)
JWT_ACCESS_SECRET=test_access_secret_change_me_00000000000
JWT_REFRESH_SECRET=test_refresh_secret_change_me_0000000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECRET=test_cookie_secret_change_me_00000000000000
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12

# Initial admin created by `pnpm --filter api seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_PASSWORD=admin123